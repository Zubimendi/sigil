{
  "name": "sigil",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "nest build collector",
    "start": "nest start collector",
    "start:dev": "nest start collector --watch",
